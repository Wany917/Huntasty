{
	"$schema": "./node_modules/nx/schemas/nx-schema.json",
	"extends": "nx/presets/npm.json",
	"cli": { "packageManager": "bun" },
	"targetDefaults": {
		"build": {
			"cache": true,
			"dependsOn": ["^build"],
			"outputs": ["{projectRoot}/dist", "{projectRoot}/.next"]
		},
		"lint": {
			"cache": true,
			"dependsOn": ["^lint"]
		},
		"check-types": {
			"cache": true,
			"dependsOn": ["^check-types"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"db:push": {
			"cache": false
		},
		"db:generate": {
			"cache": false
		},
		"db:migrate": {
			"cache": false,
			"persistent": true
		},
		"db:studio": {
			"cache": false,
			"persistent": true
		},
		"db:start": {
			"cache": false,
			"persistent": true
		},
		"db:stop": {
			"cache": false
		},
		"db:watch": {
			"cache": false,
			"persistent": true
		},
		"db:down": {
			"cache": false
		},
		"test": {
			"cache": true,
			"dependsOn": ["^build"]
		}
	}
}
