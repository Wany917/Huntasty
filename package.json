{
	"name": "Huntasty",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"dotenv": "^17.2.2",
			"zod": "^4.1.13",
			"@types/bun": "^1.3.4",
			"elysia": "^1.4.21",
			"@trpc/server": "^11.7.2",
			"better-auth": "1.5.2",
			"lucide-react": "^1.6.0",
			"next-themes": "^0.4.6",
			"sonner": "^2.0.5",
			"@trpc/tanstack-react-query": "^11.7.2",
			"@trpc/client": "^11.7.2",
			"@tanstack/react-query": "^5.90.12",
			"@tanstack/react-form": "^1.28.0",
			"@types/react-dom": "^19.2.3",
			"tailwindcss": "^4.1.18",
			"@better-auth/expo": "1.5.2"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "nx run-many -t dev",
		"build": "nx run-many -t build",
		"check-types": "nx run-many -t check-types",
		"dev:native": "nx run native:dev",
		"dev:web": "nx run web:dev",
		"dev:server": "nx run server:dev",
		"db:push": "nx run @Huntasty/db:db:push",
		"db:studio": "nx run @Huntasty/db:db:studio",
		"db:generate": "nx run @Huntasty/db:db:generate",
		"db:migrate": "nx run @Huntasty/db:db:migrate",
		"db:start": "nx run @Huntasty/db:db:start",
		"db:watch": "nx run @Huntasty/db:db:watch",
		"db:stop": "nx run @Huntasty/db:db:stop",
		"db:down": "nx run @Huntasty/db:db:down",
		"test": "nx run-many -t test",
		"check": "biome check --write .",
		"prepare": "husky"
	},
	"dependencies": {
		"@Huntasty/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@Huntasty/config": "workspace:*",
		"@biomejs/biome": "^2.2.0",
		"@sinclair/typebox": "^0.34.48",
		"@types/bun": "catalog:",
		"husky": "^9.1.7",
		"lint-staged": "^16.1.2",
		"nx": "^22.6.1",
		"typescript": "^5"
	},
	"lint-staged": {
		"*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
			"biome check --write ."
		]
	},
	"packageManager": "bun@1.3.8"
}
